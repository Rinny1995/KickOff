# Verbindung zur Datenbank (von neon.tech kopieren).
# DATABASE_URL = "pooled" Connection String (für die laufende App)
# DIRECT_URL   = direkter Connection String (nur für Prisma-Schema-Änderungen)
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Geheimer Schlüssel zum Signieren der Login-Sitzungen (Session-Cookies).
# Einfach eine lange zufällige Zeichenkette eintragen, z.B. mit:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="bitte-ersetzen-mit-zufaelligem-wert"

# Geheimer Schlüssel, mit dem sich der tägliche Cron-Job (Spielplan/Stats/
# Marktwerte, siehe vercel.json) ausweist – verhindert, dass Fremde den Job
# von außen auslösen können. Gleicher Befehl wie bei SESSION_SECRET, aber
# ein ANDERER Wert. Lokal nicht nötig (nur produktiv in Vercel gesetzt).
CRON_SECRET=""
